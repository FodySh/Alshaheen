# Supabase — من إعدادات المشروع: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# سري — للخادم فقط. يُستخدم لقراءة بريد الموظف عند إرسال التنبيهات
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# رابط الموقع النهائي (بدون / في النهاية)
NEXT_PUBLIC_SITE_URL=https://example.com

# البريد عبر Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="الشاهين لإدارة الأملاك <no-reply@example.com>"
# البريد الذي تصله طلبات التسويق الجديدة والشكاوى
OFFICE_NOTIFY_EMAIL=office@example.com
